{
  "name": "@agent-browser/desktop",
  "productName": "Agent Browser",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs && electron .",
    "typecheck": "tsc -p .",
    "package": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.agentbrowser.desktop",
    "productName": "Agent Browser",
    "directories": {
      "output": "release"
    },
    "electronDist": "node_modules/electron/dist",
    "files": [
      "dist/**/*"
    ],
    "extraResources": [
      {
        "from": "../../packages/extension/dist",
        "to": "extension"
      }
    ],
    "mac": {
      "icon": "assets/icon.icns",
      "target": [
        "dir",
        "dmg"
      ],
      "category": "public.app-category.productivity"
    }
  },
  "dependencies": {
    "@agent-browser/agent": "workspace:*",
    "@agent-browser/bridge": "workspace:*",
    "@agent-browser/protocol": "workspace:*",
    "cloakbrowser": "^0.7.1",
    "playwright-core": "^1.65.0",
    "preact": "^11.2.0"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  }
}
