{
  "name": "agent-browser",
  "private": true,
  "version": "0.1.0",
  "description": "桌面 App 内的 Agent 通过自研 Chrome 扩展操作浏览器",
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "build": "pnpm -r --filter ./packages/extension --filter ./apps/desktop run build",
    "build:extension": "pnpm --filter @agent-browser/extension run build",
    "typecheck": "pnpm -r run typecheck",
    "cli": "pnpm --filter @agent-browser/agent run cli",
    "dev": "pnpm --filter @agent-browser/desktop run dev"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
